name: Check upstream ScreenLogic sync

# Flags -- but never auto-merges -- changes to home-assistant/core's
# built-in screenlogic component, so drift like the entity-naming and
# manifest gaps doesn't silently accumulate again.

on:
  schedule:
    - cron: "0 13 * * 1" # Mondays, 13:00 UTC
  workflow_dispatch: {}

permissions:
  contents: write
  issues: write

jobs:
  check-sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Run upstream sync check
        id: sync
        run: bash .github/scripts/check_upstream_sync.sh

      - name: Find existing open sync issue
        id: existing
        if: steps.sync.outputs.changed == '1'
        uses: actions/github-script@v7
        with:
          script: |
            const { data: issues } = await github.rest.issues.listForRepo({
              owner: context.repo.owner,
              repo: context.repo.repo,
              state: "open",
              labels: "upstream-sync",
            });
            return issues.length > 0 ? issues[0].number : "";
          result-encoding: string

      - name: Read report
        if: steps.sync.outputs.changed == '1'
        id: report
        run: |
          {
            echo 'body<<EOF'
            cat upstream-sync-report.md
            echo EOF
          } >> "$GITHUB_OUTPUT"

      - name: Comment on existing issue
        if: steps.sync.outputs.changed == '1' && steps.existing.outputs.result != ''
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: ${{ steps.existing.outputs.result }},
              body: ${{ toJSON(steps.report.outputs.body) }}.slice(0, 65000),
            });

      - name: Open new issue
        if: steps.sync.outputs.changed == '1' && steps.existing.outputs.result == ''
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: "Upstream screenlogic changed in home-assistant/core",
              body: ${{ toJSON(steps.report.outputs.body) }}.slice(0, 65000),
              labels: ["upstream-sync"],
            });

      - name: Commit refreshed snapshot
        if: steps.sync.outputs.changed == '1'
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add .upstream-snapshot
          git commit -m "chore: refresh upstream screenlogic snapshot [skip ci]" || echo "Nothing to commit"
          git push
